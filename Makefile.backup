# Makefile

CC = gcc
CFLAGS = -Wall -O2 -Iinclude

# Переменные для тестового фреймворка
TEST_FRAMEWORK_DIR = test-framework
TEST_FRAMEWORK_BUILD = $(TEST_FRAMEWORK_DIR)/build
TEST_FRAMEWORK_LIB = $(TEST_FRAMEWORK_BUILD)/libtest_framework.a
TEST_INCLUDE_DIRS = -I$(TEST_FRAMEWORK_DIR)/framework/include -Itest-framework/framework/include

# Флаги для тестирования
TEST_CFLAGS = -Wall -O2 -Iinclude $(TEST_INCLUDE_DIRS) --coverage -DTESTING

# Определение операционной системы
UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
    # macOS
    LDFLAGS = -lncurses -framework CoreFoundation -framework IOKit
    TEST_LDFLAGS = -lncurses -framework CoreFoundation -framework IOKit -L$(TEST_FRAMEWORK_BUILD) -ltest_framework -lgcov
    PLATFORM_SRC = src/platform/mac_smc.c src/platform/battery.c src/platform/usb.c
else ifeq ($(UNAME_S),Linux)
    # Linux
    LDFLAGS = -lncurses
    TEST_LDFLAGS = -lncurses -L$(TEST_FRAMEWORK_BUILD) -ltest_framework -lgcov
    PLATFORM_SRC = src/platform/linux_hwmon.c src/platform/battery.c src/platform/usb_linux.c
else
    # Fallback для других систем (BSD и т.д.)
    LDFLAGS = -lncurses
    TEST_LDFLAGS = -lncurses -L$(TEST_FRAMEWORK_BUILD) -ltest_framework -lgcov
    PLATFORM_SRC = src/platform/battery.c src/platform/usb.c
endif

SRC = src/core/main.c \
            src/core/app_context.c \
            src/core/app_events.c \
            src/core/anomalies.c \
            src/core/developer.c \
            src/core/notifications.c \
            src/core/process_tree.c \
            src/ui/ui_theme.c \
            src/ui/ui_data_visualizer.c \
            src/ui/ui_window_manager.c \
            src/ui/ui_input_handler.c \
            src/ui/ui_renderer.c \
            src/ui/ui_controller.c \
            src/ui/ui_state_manager.c \
            src/modules/system_monitor.c \
            src/modules/developer_tools.c \
            src/modules/diagnostics.c \
            src/modules/prometheus.c \
            src/modules/grafana.c \
            src/platform/system_info.c \
            src/platform/processes.c \
            src/platform/disk.c \
            src/platform/network.c \
            src/platform/gpu.c \
            src/platform/smart.c \
            src/utils/config.c \
            src/utils/logging.c \
            src/utils/error_handler.c \
            $(PLATFORM_SRC)

DEMO_SRC = src/ui/modern_ui_demo.c

OBJ = $(SRC:.c=.o)
TARGET = sysmon

# Тестовые файлы
TEST_SOURCES = $(wildcard tests/*.c)
TEST_SOURCES += $(wildcard $(TEST_FRAMEWORK_DIR)/unit/**/*.c) $(wildcard $(TEST_FRAMEWORK_DIR)/integration/**/*.c)
TEST_OBJECTS = $(TEST_SOURCES:.c=.o)
TEST_BINARIES = $(TEST_SOURCES:.c=.test)

# Категории тестов
UNIT_TESTS = $(wildcard tests/test_*unit*.c tests/*unit*.c)
INTEGRATION_TESTS = $(wildcard tests/test_*integration*.c tests/*integration*.c)
PLATFORM_TESTS = $(wildcard tests/test_*platform*.c tests/*platform*.c)
CORE_TESTS = $(wildcard tests/test_*core*.c tests/*core*.c tests/test_*system*.c tests/*system*.c tests/test_*module*.c tests/*module*.c)

all: $(TARGET)

$(TARGET): $(OBJ)
	$(CC) $(OBJ) -o $@ $(CFLAGS) $(LDFLAGS)

%.o: %.c
	$(CC) -c $< -o $@ $(CFLAGS)

# Цель для сборки демо UI отдельно
demo_ui: $(DEMO_SRC:.c=.o) src/ui/ui_theme.o src/ui/ui_renderer.o src/ui/ui_controller.o
	$(CC) $^ -o demo_ui $(CFLAGS) $(LDFLAGS)

# ============================================================================
# Цели тестирования
# ============================================================================

# Сборка тестового фреймворка
test-framework: $(TEST_FRAMEWORK_LIB)
	@echo "Тестовый фреймворк собран"

# Правило сборки библиотеки тестового фреймворка
$(TEST_FRAMEWORK_LIB):
	@echo "Сборка библиотеки тестового фреймворка..."
	@mkdir -p $(TEST_FRAMEWORK_BUILD)
	$(MAKE) -C $(TEST_FRAMEWORK_DIR) framework

# Сборка всех тестов
test: test-unit test-integration
	@echo "Все тесты выполнены"

# Сборка и запуск unit тестов
test-unit: $(TEST_FRAMEWORK_LIB) $(UNIT_TESTS:.c=.test)
	@echo "Запуск unit тестов..."
	@for test in $(UNIT_TESTS:.c=.test); do \
		if [ -f "$$test" ]; then \
			echo "Выполнение $$test"; \
			./$$test; \
		fi \
	done

# Сборка и запуск интеграционных тестов
test-integration: $(TEST_FRAMEWORK_LIB) $(INTEGRATION_TESTS:.c=.test)
	@echo "Запуск интеграционных тестов..."
	@for test in $(INTEGRATION_TESTS:.c=.test); do \
		if [ -f "$$test" ]; then \
			echo "Выполнение $$test"; \
			./$$test; \
		fi \
	done

# Сборка и запуск платформенных тестов
test-platform: $(TEST_FRAMEWORK_LIB) $(PLATFORM_TESTS:.c=.test)
	@echo "Запуск платформенных тестов..."
	@for test in $(PLATFORM_TESTS:.c=.test); do \
		if [ -f "$$test" ]; then \
			echo "Выполнение $$test"; \
			./$$test; \
		fi \
	done

# Сборка и запуск core тестов
test-core: $(TEST_FRAMEWORK_LIB) $(CORE_TESTS:.c=.test)
	@echo "Запуск core тестов..."
	@for test in $(CORE_TESTS:.c=.test); do \
		if [ -f "$$test" ]; then \
			echo "Выполнение $$test"; \
			./$$test; \
		fi \
	done

# Генерация отчета покрытия кода
test-coverage: CFLAGS += --coverage
test-coverage: clean test
	@echo "Генерация отчета покрытия кода..."
	@gcov $(SRC) 2>/dev/null | head -20
	@echo "Отчет покрытия создан"

# Правило сборки тестовых исполняемых файлов
%.test: %.c $(TEST_FRAMEWORK_LIB)
	$(CC) $< -o $@ $(TEST_CFLAGS) $(LDFLAGS) -L$(TEST_FRAMEWORK_BUILD) -ltest_framework -lgcov

clean:
	rm -f $(OBJ) $(TARGET) demo_ui $(TEST_BINARIES)
	rm -f *.gcno *.gcda *.gcov

# Полная очистка включая тестовые файлы
clean-all: clean
	rm -rf $(TEST_FRAMEWORK_BUILD)
	$(MAKE) -C $(TEST_FRAMEWORK_DIR) clean

# ============================================================================
# Справка и информация
# ============================================================================

help:
	@echo "Доступные цели сборки:"
	@echo "  all              - Сборка основного приложения"
	@echo "  demo_ui          - Сборка демо интерфейса"
	@echo "  clean            - Очистка файлов сборки"
	@echo "  clean-all        - Полная очистка включая тестовый фреймворк"
	@echo ""
	@echo "Доступные цели тестирования:"
	@echo "  test-framework   - Сборка тестового фреймворка"
	@echo "  test             - Запуск всех тестов"
	@echo "  test-unit        - Запуск unit тестов"
	@echo "  test-integration - Запуск интеграционных тестов"
	@echo "  test-platform    - Запуск платформенных тестов"
	@echo "  test-core        - Запуск core тестов"
	@echo "  test-coverage    - Генерация отчета покрытия кода"
	@echo ""
	@echo "Примеры использования:"
	@echo "  make test-framework  # Сборка только тестового фреймворка"
	@echo "  make test           # Запуск всех тестов"
	@echo "  make test-unit      # Запуск только unit тестов"
	@echo "  make clean-all      # Полная очистка проекта"

.PHONY: all clean demo_ui test test-unit test-integration test-platform test-core test-coverage test-framework clean-all help